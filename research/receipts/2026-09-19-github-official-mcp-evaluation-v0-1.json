  "component_evaluation": {
    "repository_pr_actions_reads": {
      "decision": "READ_ONLY_DIAGNOSTIC_CANDIDATE",
      "fit": "HIGH_IF_PROJECT_RUNTIME_NEEDS_GITHUB",
      "notes": [
        "Repository content/commit, pull-request read and Actions status/log tools could support operator diagnostics.",
        "The project already has an established GitHub workflow, so a second runtime should only be added for a concrete unattended/operator requirement."
      ]
    },
    "read_only_mode": {
      "decision": "REQUIRED_UPPER_BOUND_FOR_ANY_FUTURE_PROJECT_RUNTIME",
      "fit": "HIGH",
      "notes": [
        "The pinned server supports X-MCP-Readonly, /readonly, --read-only and GITHUB_READ_ONLY depending on transport.",
        "Upstream documents read-only mode as taking precedence over other tool configuration and disabling non-read-only tools."
      ]
    },
    "tool_filtering": {
      "decision": "REQUIRED_MINIMUM_SURFACE",
      "fit": "HIGH",
      "notes": [
        "The pinned server supports specific toolsets, individual tools and explicit exclusions.",
        "A future project adapter should expose only the exact repository/PR/Actions read surfaces it needs rather than the default or all toolsets."
      ]
    },
    "write_capabilities": {
      "decision": "REJECT_FOR_CURRENT_PROJECT_RUNTIME",
      "fit": "LOW_WITH_CURRENT_NEED",
      "notes": [
        "The source inventory contains repository/file, issue, pull-request, workflow and other mutation tools.",
        "Those capabilities overlap authority already governed by the project's explicit branch/PR/CI workflow."
      ]
    },
    "authentication": {
      "decision": "SEPARATE_LEAST_PRIVILEGE_BOUNDARY_REQUIRED",
      "fit": "HIGH_IMPORTANCE",
      "notes": [
        "OAuth/PAT/GitHub App permissions remain effective independently of MCP filtering.",
        "A future integration must combine least-privilege GitHub permissions with MCP read-only/tool allowlisting."
      ]
    },
    "lockdown_mode": {
      "decision": "OPTIONAL_CONTENT_HARDENING_NOT_AUTHORIZATION",
      "fit": "MEDIUM",
      "notes": [
        "Upstream documents lockdown mode as best-effort prompt-injection/content filtering.",
        "It is not a security or permission boundary and cannot replace read-only mode or credential scoping."
      ]
    }
  },
  "overall_decision": {
    "state": "EVALUATED_NOT_APPROVED_FOR_RUNTIME_INTEGRATION",
    "recommended_scope": "READ_ONLY_REPO_PR_ACTIONS_DIAGNOSTIC_ALLOWLIST_IF_NEEDED",
    "do_not_duplicate_existing_github_workflow_without_gap": true,
    "require_read_only_mode_for_future_runtime": true,
    "require_least_privilege_credential": true,
    "require_tool_allowlist": true,
    "do_not_treat_lockdown_as_authorization": true,
    "recommended_next_step": "Keep as evaluated reference. Add no project runtime unless a concrete unattended/operator GitHub diagnostic requirement cannot be met by the existing controlled workflow."
  },
