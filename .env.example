# V0.1 does not require private Pionex credentials.
# Keep placeholders only. Never commit real values.
PIONEX_API_KEY=
PIONEX_API_SECRET=

# Cloudflare R2 historical store.
# Store real values only in local/GitHub secret managers.
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Render diagnostic / successor metadata relay secret names.
# Real values are provisioned out of band. Never commit them, paste them into
# issues/logs/chat, or give Render any R2 credential.
DIAGNOSTIC_TOKEN=
METADATA_RELAY_TOKEN=

# Future Cloudflare services.
D1_DATABASE_ID=
