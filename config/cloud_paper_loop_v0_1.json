{
  "schema": "qookey-cloud-paper-loop-v0.1",
  "status": "AUTHORIZED_ON_PROTECTED_MAIN_MERGE",
  "mode": "PAPER_AND_LIVE_PAPER_ONLY",
  "activation": {
    "enabled": false,
    "receipt": "research/receipts/cloud-paper-loop-v0-1-activation.json",
    "require_implementation_sha_binding": true,
    "require_cloud_ci_success": true,
    "require_controlled_main_acceptance": true,
    "require_free_only_evidence": true
  },
  "schedule": {
    "cron_utc": "7,22,37,52 * * * *",
    "timeout_minutes": 10,
    "maximum_slots_per_utc_day": 96,
    "concurrency_group": "live-paper-persistence-v0-1",
    "backfill": false,
    "rerun_consumed_slots": false,
    "stale_start_max_seconds": 600
