    "cloudflare_worker_execution_authorized": false
  },
  "providers": {
    "pionex": {
      "public_endpoint": "https://api.pionex.com/api/v1/common/symbols",
      "required_http_status": 200,
      "max_response_bytes": 5000000,
      "selected_symbol_field": "data.symbols[].symbol",
      "required_metadata_field": "data.symbols[].quoteStep"
