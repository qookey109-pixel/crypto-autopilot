  "stage": "PROVIDER_EQUIVALENCE_V0_2_LOCAL_TRANSPORT_PROBE_PROTOCOL_FROZEN",
  "purpose": "Prove that an operator-controlled local execution transport can reach the unchanged official Pionex and Binance USD-M public metadata endpoints before any new forward holdout is frozen.",
  "authority_prerequisite": "research/receipts/2026-08-19-provider-equivalence-v0-2-transport-blocked.json",
