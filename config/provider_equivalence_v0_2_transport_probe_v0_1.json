      "public_endpoint": "https://fapi.binance.com/fapi/v1/exchangeInfo",
      "required_http_status": 200,
      "max_response_bytes": 10000000,
      "selected_symbol_field": "symbols[].symbol",
      "required_metadata_field": "symbols[].filters[filterType=PRICE_FILTER].tickSize"
    }
  },
  "pass_criteria": {
    "both_providers_http_200": true,
    "both_payloads_json_parse": true,
    "all_15_frozen_symbols_present_once_per_provider": true,
    "required_metadata_field_present_for_all_selected_symbols": true,
    "increment_values_must_not_be_emitted": true,
    "r2_client_must_not_be_constructed": true,
    "r2_writes_must_be_zero": true,
    "holdout_candles_must_not_be_accessed": true
  },
  "evidence_output": {
    "format": "json",
    "raw_payload_retained": false,
    "raw_payload_sha256_recorded": true,
    "raw_payload_bytes_recorded": true,
    "selected_symbol_count_recorded": true,
    "increment_values_emitted": false,
    "hostname_recorded": false,
    "ip_address_recorded": false
  },
  "authorization_boundary": {
