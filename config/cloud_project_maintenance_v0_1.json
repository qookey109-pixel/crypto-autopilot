{
  "schema": "cloud-project-maintenance-v0.1",
  "status": "AUTHORIZED_ON_MAIN_MERGE",
  "repository": "qookey109-pixel/crypto-autopilot",
  "purpose": "GitHub-hosted metadata observation and deterministic draft proposals for two generated documentation blocks only.",
  "health_workflow": ".github/workflows/research-automation-health-v0-2.yml",
  "health_policy": "config/research_automation_health_v0_2.json",
  "trigger": {
    "type": "workflow_run",
    "event": "schedule",
    "branch": "main",
    "same_repository": true,
    "exact_source_main_required": true,
    "new_cron": false
  },
  "write_paths": [
    "CURRENT_STATUS.md",
    "docs/PROJECT_CONTINUATION_RUNBOOK.md"
  ],
  "authority": {
    "github_metadata_read": true,
    "generated_blocks_write": true,
    "draft_pr": true,
    "merge": false,
    "dispatch": false,
    "provider": false,
    "r2": false,
    "holdout": false,
    "training": false,
    "promotion": false,
    "trading": false,
    "local_user_files": false,
    "paid_runtime": false
  },
  "runtime": {
    "host": "github-hosted",
    "runner": "ubuntu-latest",
    "language": "Python 3.13",
    "dependencies": "stdlib plus existing pure health evaluator",
    "model_required": false,
    "monthly_budget_usd": 0,
    "public_repository_required": true
  },
  "evidence": {
    "run_summary": true,
    "artifact_upload": false,
    "artifact_download": false,
    "logs_read": false,
    "pagination_max_pages": 10,
    "metadata_lookback_days": 14,
    "missing_pages": "STOP_UNKNOWN",
    "research_result": "UNKNOWN_FROM_METADATA"
  },
  "publication": {
    "draft_only": true,
    "branch_prefix": "codex/cloud-maintenance-",
    "max_open_proposals": 1,
    "force_push": false,
    "main_changes": "STOP",
    "human_changes": "STOP",
    "self_pr_in_projection": false,
    "timestamp_only_commit": false
  },
  "acceptance": {
    "natural_runs_required": 2,
    "no_change_commit_count": 0,
    "status": "NOT_YET_VERIFIED",
    "merge_approval": "USER_REQUIRED",
    "ci_approval": "HUMAN_IF_GITHUB_REQUIRES"
  }
}
