{
  "schema": "challenger-promotion-protocol-v0.1",
  "version": "0.1.0",
  "status": "PREPARED_EVIDENCE_GATE_ONLY",
  "purpose": "Freeze quantitative graduation evidence before reading integrated challenger results. Passing evidence permits human review only and never promotes automatically.",
  "common_integrity_gates": {
    "lineage_complete": true,
    "no_lookahead": true,
    "provider_separated": true,
    "holdout_untouched": true,
    "formal_baseline_unchanged": true,
    "minimum_walk_forward_folds": 4,
    "minimum_positive_fold_fraction": 0.75,
    "minimum_total_out_of_sample_trades": 300,
    "minimum_median_net_expectancy_r": 0.05,
    "minimum_cost_stress_net_expectancy_r": 0.0,
    "maximum_drawdown_pct": 25.0,
    "maximum_single_symbol_fraction": 0.10,
    "maximum_leverage_rejection_fraction": 0.35,
    "minimum_expectancy_lift_vs_baseline_r": 0.0
  },
  "tracks": {
    "CORE_LONG_SHORT": {
      "minimum_side_trades": {
        "LONG": 100,
        "SHORT": 100
      },
      "minimum_regime_trades": {
        "TREND_UP": 50,
        "TREND_DOWN": 50,
        "RANGE": 50
      }
    },
    "TOKENIZED_EQUITY": {
      "minimum_total_out_of_sample_trades": 150,
      "minimum_distinct_symbols": 3,
      "minimum_session_policy_coverage": 1.0,
      "minimum_corporate_action_policy_coverage": 1.0,
      "spread_stress_must_pass": true
    }
  },
  "result_semantics": {
    "passing_status": "EVIDENCE_READY_FOR_HUMAN_REVIEW",
    "failing_status": "REJECT",
    "automatic_promotion_authorized": false,
    "formal_strategy_change_authorized": false,
    "trading_authorized": false
  },
  "authority": {
    "provider_reads_authorized": false,
    "r2_reads_authorized": false,
    "r2_writes_authorized": false,
    "holdout_access_authorized": false,
    "automatic_model_promotion_authorized": false,
    "automatic_trade_plan_authorized": false,
    "real_money_order_authorized": false,
    "live_trading_authorized": false
  }
}
