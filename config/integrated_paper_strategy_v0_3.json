{
  "schema": "integrated-paper-strategy-challenger-config-v0.3",
  "version": "0.3.0",
  "status": "PREPARED_LOCAL_REPLAY_ONLY",
  "purpose": "Add separated portfolio and independent-signal evidence lanes plus reward-risk diagnostics without changing formal V0.1.",
  "baseline_sources": {
    "formal_strategy": "config/strategy_v0_1.json",
    "integrated_v0_2": "config/integrated_paper_strategy_v0_2.json",
    "promotion_protocol": "config/challenger_promotion_protocol_v0_2.json",
    "experiment_registry": "config/challenger_experiment_registry_v0_1.json",
    "sstate_calibration": "config/sstate_gate_calibration_v0_1.json",
    "short_calibration": "config/short_score_calibration_v0_1.json"
  },
  "sstate_bridge": {
    "allowed_states": ["S3", "S0.5", "S2", "S1"],
    "minimum_probability": 0.60,
    "minimum_samples": 50,
    "minimum_long_strategy_score": 80.0,
    "long_mode": "FORMAL_V0_1_DECISION_REQUIRED",
    "short_mode": "CONTEXT_GATE_PLUS_INDEPENDENT_TECHNICAL_SCORE_RESEARCH",
    "scores_are_not_added": true,
    "short_formal_strategy_score_available": false,
    "gate_recalibration_required_before_review": true
  },
  "technical_candidate": {
    "candidate_thresholds": {
      "minimum_trend_agreement": 0.75,
      "minimum_adx14": 18.0,
      "minimum_rsi14": 45.0,
      "maximum_rsi14": 75.0,
      "short_minimum_rsi14": 25.0,
      "short_maximum_rsi14": 55.0,
      "minimum_donchian_position": 0.80,
      "maximum_donchian_position": 0.20,
      "minimum_volume_zscore": -0.50,
      "minimum_efficiency_ratio": 0.20,
      "minimum_candidate_score": 65.0
    },
    "paper_risk": {
      "stop_atr_multiple": 1.5,
      "target_atr_multiple": 3.0
    }
  },
  "asset_policy": {
    "allowed_asset_classes": ["crypto", "tokenized_stock_candidate"],
    "required_provider": "pionex_public_futures",
    "required_status": "TRADING",
    "required_intervals": ["15M", "60M", "4H", "8H", "1D"],
    "crypto_maximum_spread_bps": 25.0,
    "tokenized_maximum_spread_bps": 40.0,
    "tokenized_session_model_required": true,
    "tokenized_corporate_action_policy_required": true
  },
  "stop_policy": {
    "mode": "WIDEST_VALID_STRUCTURE_WITH_BUFFER_AND_ATR_BOUNDS",
    "candidate_sources": ["DIRECTIONAL_ATR", "EMA20", "BOLLINGER_MID", "BOLLINGER_HALF_BAND"],
    "bollinger_half_band_fraction": 0.5,
    "structure_buffer_atr": 0.10,
    "minimum_distance_atr": 0.75,
    "maximum_distance_atr": 2.5,
    "fixed_percentage_stop_authorized": false
  },
  "portfolio_risk": {
    "initial_equity_usd": 10000.0,
    "maximum_risk_fraction_per_trade": 0.01,
    "maximum_leverage": 3.0,
    "maximum_new_trades_per_utc_day": 3,
    "daily_loss_limit_r": 3.0,
    "maximum_concurrent_positions": 1,
    "leverage_conflict_policy": "REJECT_PLAN",
    "record_effective_risk_and_leverage_rejections": true,
    "risk_budget_interpretation": "MAXIMUM_EQUITY_LOSS_AT_INITIAL_STOP_NOT_STOP_DISTANCE",
    "position_size_scales_inverse_to_stop_distance": true
  },
  "cost_model": {
    "taker_fee_bps": 5.0,
    "slippage_bps": 2.0,
    "funding_enabled": true
  },
  "exit_policy": {
    "partial_at_r": 1.0,
    "partial_fraction": 0.30,
    "runner_fraction": 0.70,
    "move_runner_stop_to_cost_adjusted_breakeven": true,
    "runner_trailing_distance_r": 1.0,
    "fixed_directional_target_enabled": true,
    "maximum_holding_minutes": 720,
    "hard_time_exit": true,
    "conservative_same_bar_path": true
  },
  "evidence_lanes": {
    "portfolio": {
      "maximum_concurrent_positions": 1,
      "portfolio_performance_valid": true,
      "purpose": "Executable portfolio drawdown, equity and utilization evidence"
    },
    "independent_signal_exploration": {
      "overlapping_samples_allowed": true,
      "fixed_reference_equity": true,
      "portfolio_performance_valid": false,
      "aggregate_pnl_must_not_be_reported_as_portfolio_pnl": true,
      "purpose": "Signal, side, regime, stop and calibration evidence"
    }
  },
  "diagnostics": {
    "stop_distance_atr_quantiles": [0.50, 0.75, 0.90, 0.95],
    "planned_reward_risk_thresholds": [1.20, 1.50, 2.00],
    "group_by_stop_source": true,
    "group_leverage_rejections_by_side_regime_and_stop_source": true
  },
  "research_context": {
    "kol_or_sentiment_can_change_eligibility": false,
    "context_is_evidence_only": true
  },
  "authority": {
    "provider_reads_authorized": false,
    "r2_reads_authorized": false,
    "r2_writes_authorized": false,
    "schedule_authorized": false,
    "holdout_access_authorized": false,
    "formal_strategy_change_authorized": false,
    "automatic_model_promotion_authorized": false,
    "automatic_trade_plan_authorized": false,
    "real_money_order_authorized": false,
    "live_trading_authorized": false
  }
}
