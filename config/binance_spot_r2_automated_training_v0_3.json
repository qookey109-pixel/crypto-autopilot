{
  "version": "0.3.0",
  "status": "R2_FIRST_AUTOMATED_TRAINING_AUTHORIZED_ON_MAIN_MERGE",
  "provider": "binance_spot",
  "delivery": "binance_public_rest",
  "dataset": "spot_1d_internal_training",
  "schedule": {
    "cron_utc": "37 2 * * *",
    "workflow_dispatch_enabled": true,
    "provider_read_stop_utc": "2026-08-27T00:00:00Z",
    "automatic_resume_after_stop": false,
    "stop_reason": "Preserve the frozen V0.10 replacement-holdout boundary until a separate post-window authority exists."
  },
  "source": {
    "start_utc": "2020-01-01T00:00:00Z",
    "end_policy": "LAST_COMPLETE_UTC_DAY",
    "interval": "1d",
    "quotes": ["USDT", "USDC"],
    "requests_per_second": 5
  },
  "storage": {
    "backend": "cloudflare_r2",
    "dataset_runs_namespace": "market-data/binance_spot/internal-training/v0.3/runs",
    "training_namespace": "training/binance_spot/daily-direction/v0.3",
    "latest_training_pointer_key": "training/binance_spot/daily-direction/v0.3/latest.json",
    "free_only_hard_stop_bytes": 8000000000,
    "fresh_whole_bucket_inventory_before_write": true,
    "round_trip_sha256_verification_required": true,
    "credentials_location": "github_actions_secrets_only"
  },
  "training": {
    "model_family": "deterministic_logistic_regression",
    "target": "next_complete_daily_close_up",
    "feature_names": ["return_1d", "return_3d", "return_7d", "close_vs_ma7", "quote_volume_vs_ma7"],
    "asset_classes": ["crypto", "stablecoin", "tokenized_stock_candidate", "other"],
    "audit_ok_required": true,
    "minimum_train_samples": 200,
    "minimum_test_samples": 50,
    "max_train_samples_per_class": 200000,
    "max_test_samples_per_class": 100000,
    "epochs": 8,
    "learning_rate": 0.08,
    "l2": 0.0001,
    "website_projection_authorized": false
  },
  "authority": {
    "github_actions_scheduled_sync_authorized": true,
    "binance_public_market_reads_authorized": true,
    "production_r2_client_construction_authorized": true,
    "production_r2_reads_authorized": true,
    "production_r2_writes_authorized_for_exact_namespaces": true,
    "automated_research_model_training_authorized": true,
    "provider_splicing_authorized": false,
    "pionex_native_relabel_authorized": false,
    "source_switch_authorized": false,
    "holdout_access_authorized": false,
    "historical_universe_membership_authorized": false,
    "backtest_admission_authorized": false,
    "automatic_trade_plan_authorized": false,
    "real_money_order_authorized": false,
    "live_trading_authorized": false
  }
}
