{
  "schema": "paper-long-short-challenger-config-v0.2",
  "version": "0.2.0",
  "status": "PREPARED_LOCAL_REPLAY_ONLY",
  "direction": "LONG_SHORT",
  "purpose": "Evaluate independent long and short paper samples without changing the governed LONG_ONLY V0.1 baseline.",
  "candidate_thresholds": {
    "minimum_trend_agreement": 0.75,
    "minimum_adx14": 18.0,
    "minimum_rsi14": 45.0,
    "maximum_rsi14": 75.0,
    "short_minimum_rsi14": 25.0,
    "short_maximum_rsi14": 55.0,
    "minimum_donchian_position": 0.80,
    "maximum_donchian_position": 0.20,
    "minimum_volume_zscore": -0.50,
    "minimum_efficiency_ratio": 0.20,
    "minimum_candidate_score": 65.0
  },
  "paper_risk": {
    "stop_atr_multiple": 1.5,
    "target_atr_multiple": 3.0
  },
  "limits": {
    "max_samples_per_utc_day": 12,
    "max_samples_per_symbol_per_utc_day": 2,
    "risk_fraction_per_sample": 0.0025,
    "initial_equity_usd": 10000.0,
    "max_leverage": 3.0,
    "taker_fee_bps": 5.0,
    "slippage_bps": 2.0
