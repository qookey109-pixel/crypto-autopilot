{
  "schema": "qookey-crypto-toolkit-api-v0.2",
  "status": "PREPARED_RESEARCH_ONLY",
  "toolkit_version": "0.2",
  "origin": {
    "runtime": "FULL_CPYTHON",
    "entrypoint": "scripts/qookey_crypto_toolkit_http_v0_2.py",
    "max_request_bytes": 2000000,
    "non_loopback_requires_bearer_token": true,
    "bearer_token_env": "QOOKEY_TOOLKIT_API_TOKEN",
    "cors_default": "DISABLED",
    "public_routes": [
      "GET /healthz",
      "GET /openapi.json",
      "GET /v0/capabilities"
    ],
    "protected_routes": [
      "POST /v0/validate",
      "POST /v0/indicators",
      "POST /v0/strategy",
      "POST /v0/risk",
      "POST /v0/backtest",
      "POST /v0/stress",
      "POST /v0/compare",
      "POST /v0/report"
    ]
  },
  "cloudflare_edge": {
    "status": "IMPLEMENTED_NOT_DEPLOYED",
    "path": "infra/cloudflare/qookey-toolkit-edge",
    "role": "AUTH_ROUTING_LIMITS_AND_ORIGIN_PROXY_ONLY",
    "client_token_secret": "EDGE_API_TOKEN",
    "origin_token_secret": "ORIGIN_API_TOKEN",
    "origin_url_secret": "TOOLKIT_ORIGIN",
    "provider_credentials_allowed": false,
    "r2_binding_allowed": false,
    "holdout_binding_allowed": false
  },
  "render_origin": {
    "status": "IMPLEMENTED_NOT_DEPLOYED",
    "path": "infra/render/qookey-toolkit-api",
    "container_installs_repository_cloud_dependencies": false,
    "expected_health_path": "/healthz"
  },
  "deployment": {
    "automatic_deploy_authorized": false,
    "public_exposure_authorized": false,
    "secrets_must_not_be_committed": true
  },
  "safety_boundary": {
    "provider_access_authorized": false,
    "r2_access_authorized": false,
    "holdout_access_authorized": false,
    "source_switch_authorized": false,
    "synthetic_candles_authorized": false,
    "interpolation_authorized": false,
    "automatic_strategy_mutation_authorized": false,
    "automatic_model_promotion_authorized": false,
    "formal_trade_plan_authorized": false,
    "real_money_order_authorized": false,
    "live_trading_authorized": false
  }
}
