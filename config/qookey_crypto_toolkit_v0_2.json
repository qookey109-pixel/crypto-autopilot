{
  "schema": "qookey-crypto-toolkit-v0.2",
  "status": "PREPARED_RESEARCH_ONLY",
  "execution_model": "CLOUD_FIRST",
  "base": {
    "v0_1_compatibility_preserved": true,
    "python_package": "crypto_autopilot.toolkit",
    "cli": "scripts/qookey_crypto_toolkit_v0_2.py",
    "user_local_execution_required": false
  },
  "tools": [
    "get_indicators",
    "evaluate_strategy",
    "size_long_trade",
    "run_paper_backtest",
    "validate_candles",
    "stress_paper_backtest",
    "compare_backtests",
    "validate_statistical_edge",
    "build_research_report"
  ],
  "resource_hub_integrations": {
    "registry": "config/resource_hub_integrations_v0_1.json",
    "active_native_capabilities": [
      "validate_statistical_edge"
    ],
    "prepared_disabled_integrations": [
      "boundaryml-baml",
      "trailhq-graft",
      "world-monitor",
      "agent-reach"
    ]
  },
  "interfaces": {
    "github_actions": "PRIMARY_CLOUD_INTERFACE",
    "python": "INTERNAL_REUSABLE_RUNNER",
    "cli": "INTERNAL_REUSABLE_RUNNER",
    "rest_api": "DEFERRED",
    "telegram": "DEFERRED",
    "mcp": "DEFERRED"
  },
  "cloud_execution": {
    "workflow": ".github/workflows/qookey-crypto-toolkit-v0-2-cloud.yml",
    "trigger": "workflow_dispatch",
    "runner": "github_hosted_ubuntu",
    "input_mode": "REPOSITORY_CONTROLLED_JSON",
    "artifact_output": true,
    "local_machine_required": false,
    "r2_input_enabled": false
  },
  "research_guards": {
    "network_required": false,
    "secrets_required": false,
    "candle_repair_performed": false,
    "interpolation_performed": false,
    "synthetic_candles_emitted": false,
